#!/usr/bin/env bash
# Fast-path checks at commit time. CI remains the guarantee — this exists so
# malformed work never leaves the machine. Activate with:
#   ./install-pre-commit-hooks.sh   (idempotent; run once per session)
#
# PRINCIPLE (pilot-learned): each block MIRRORS a CI check, same tool, same
# version — a commit that passes the hook passes the corresponding required
# status check. Keep blocks cheap (seconds); expensive suites belong in CI.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# --- protected-branch guard --------------------------------------------------
# Runs FIRST and exits before any of the checks below: this is a policy refusal,
# not a quality gate, so there is no reason to spend seconds on formatting and
# type-checks for a commit that must not exist.
#
# Every INFORMUP repo lands changes through a PR from a worktree, and the
# integration branches are protected server-side — so a local commit on one can
# never be pushed. It is always a mistake, but a SILENT one: the commit succeeds
# and only surfaces later at `git push`, by which point the work sits on a branch
# that a later fast-forward will refuse to advance.
#
# Which branches are protected differs by repo: TaskFlow integrates on `main`,
# while reportal / ghost / dashboard-backend integrate on `staging` and promote
# to `main`, so both are off-limits there. The default covers all of them; a repo
# that needs a different set overrides it without editing this file:
#
#   git config informup.protectedBranches "main develop"
#
# A detached HEAD is deliberately allowed — that is a rebase or bisect, and
# blocking it would break rebases outright, a worse failure than the one being
# prevented. Escape hatch is the standard `git commit --no-verify`.
PROTECTED_BRANCHES="$(git -C "$ROOT" config --get informup.protectedBranches || echo "main master staging")"
current_branch="$(git -C "$ROOT" branch --show-current)"

if [[ -n "$current_branch" ]]; then
  for protected in $PROTECTED_BRANCHES; do
    if [[ "$current_branch" == "$protected" ]]; then
      cat >&2 <<EOF

  ✗ refusing to commit on '$current_branch'

  This repo lands every change through a PR opened from a worktree, and
  '$current_branch' is protected on the server — this commit could never be pushed.

  Move the work to a worktree off the integration branch:

      git worktree add -b <type>/<short-desc> .claude/worktrees/<short-desc> origin/$current_branch

  Staged changes stay staged — nothing is lost. To carry them across, commit from
  inside the new worktree, or:

      git stash push -m wip && cd .claude/worktrees/<short-desc> && git stash pop

  Protected here: $PROTECTED_BRANCHES
  (override with: git config informup.protectedBranches "...")

  If you genuinely mean this, bypass with:  git commit --no-verify

EOF
      exit 1
    fi
  done
fi

# How many real checks actually ran. The closing line reports against this
# rather than asserting success unconditionally: a hook that verified nothing
# must never print "checks passed", because that reads — to a human and to an
# agent — exactly like a gate that ran and approved the change. That false
# assurance is what let a type error into tissue-core's main on 2026-08-25.
checks_run=0

# --- docs-only short-circuit -------------------------------------------------
# This repo's own worktree convention (see the top-level CLAUDE.md) means a
# markdown-only commit routinely happens in a brand-new worktree that has
# never had `npm install` run in it — a worklog entry, a doc fix. The
# typecheck and reuse-inventory blocks below cannot possibly have anything to
# say about a change that touches no code, but until now they ran anyway and
# demanded tooling the commit had no use for. That friction was hit for real
# on 2026-08-29 committing a worklog entry in tissue-core, and the workaround
# was `--no-verify` — exactly the habit this hook exists to discourage, since
# it bypasses every other gate along with the one that didn't apply.
#
# Judged from the STAGED paths, computed once here so both blocks below can
# consult it without re-running the diff:
#
#   git diff --cached --name-only --no-renames
#
# --no-renames is REQUIRED, not cosmetic. With rename detection on, moving
# api/foo.ts to docs/foo.md prints only the destination path (docs/foo.md) —
# git treats it as one renamed file, not a delete+add pair — so the commit
# would read as docs-only while actually relocating real code. Turning
# detection off makes git report the deletion and the addition as two
# separate paths, so the code-shaped side of the move still counts.
#
# There is also deliberately no --diff-filter here. A commit that only
# DELETES a .ts file has no destination content to judge by extension, but it
# is still a real code change — a typecheck can fail or a stale import can
# break as a direct result of a deletion — so deletions must count toward
# disqualifying docs-only, not be filtered out of consideration.
#
# A path counts as "docs" iff it ends in .md or lives under docs/. EVERY
# staged path must qualify for the commit to be docs-only; a single
# non-qualifying path (added, modified, or deleted) disqualifies the whole
# commit. An empty staged list is NOT docs-only either — there is nothing to
# judge it by, so it falls through to the normal path below and lets the
# ordinary (possibly still-unconfigured) typecheck gate decide.
is_docs_only() {
  local staged path
  staged="$(git -C "$ROOT" diff --cached --name-only --no-renames)"
  [[ -n "$staged" ]] || return 1
  while IFS= read -r path; do
    [[ "$path" == *.md || "$path" == docs/* ]] || return 1
  done <<<"$staged"
  return 0
}

DOCS_ONLY=false
if is_docs_only; then
  DOCS_ONLY=true
  echo "==> Docs-only commit — code gates skipped (markdown/docs paths only)."
fi

# Keep docs/inventory.md (the reuse-surface index) in sync automatically:
# regenerate from the working tree and stage it, so a commit touching the
# reuse surface can't leave the index stale (CI drift-checks it; this spares
# a red build). No-ops when nothing changed. Guarded so the hook works on
# branches predating the generator.
if [[ "$DOCS_ONLY" != true && -f "$ROOT/scripts/generate-inventory.mjs" ]]; then
  echo "==> Regenerating reuse inventory (docs/inventory.md)..."
  (cd "$ROOT" && node scripts/generate-inventory.mjs)
  git -C "$ROOT" add docs/inventory.md
  checks_run=$((checks_run + 1))
fi

# Mirror the CI `format` job with the root-pinned formatter version.
# Requires a root package.json with a format:check script (Prettier setups).
#
# This one runs even on a docs-only commit, deliberately NOT gated on
# DOCS_ONLY: Prettier formats markdown too, so this gate genuinely applies to
# a docs-only change and skipping it here would be "tidying" a real check
# away rather than closing an irrelevant one. Leave it unconditional.
if [[ -f "$ROOT/package.json" ]] && grep -q '"format:check"' "$ROOT/package.json"; then
  echo "==> Checking formatting (Prettier)..."
  (cd "$ROOT" && npm run format:check)
  checks_run=$((checks_run + 1))
fi

# Refuses the commit when a package the typecheck needs has no node_modules.
# A bare `npx <tool>` in a dependency-less tree does not fail — it downloads
# whatever version of <tool> is newest and runs that (tissue-core 2026-09-30:
# `npx prisma generate` fetched prisma@8.0.0-rc.19). Checking first turns that
# into one clear refusal instead of a stray install followed by `tsc: not found`.
require_installed_deps() { # <package-dir>...
  local missing=() dir
  for dir in "$@"; do
    [[ -d "$ROOT/$dir/node_modules" ]] || missing+=("$dir")
  done
  [[ ${#missing[@]} -eq 0 ]] && return 0
  cat >&2 <<EOF

  ✗ dependencies not installed in: ${missing[*]}

  The typecheck needs them, and running it anyway would let npx fetch an
  unpinned tool from the registry. Install first:

      ./setup-worktree.sh

  To get past this one commit without checking:  git commit --no-verify

EOF
  exit 1
}

# --- typecheck (EDIT PER STACK — THIS HOOK REFUSES TO RUN UNTIL YOU DO) ------
#
# This block ships UNCONFIGURED and fails closed. That is deliberate, and it is
# the correction of a real defect rather than a precaution.
#
# It used to ship commented out under an "EDIT PER STACK" banner, on the
# reasonable assumption that each repo would fill it in. Four of the six repos
# carrying the hook never did — and because every other block here self-skips on
# its own `[[ -f ... ]]` guard, those hooks ran, exited 0, and announced
# "Pre-commit checks passed" having verified nothing at all. Nobody noticed,
# because a silent green gate is indistinguishable from a working one.
#
# It stayed harmless only while CI covered the same ground. On 2026-08-25, with
# GitHub Actions blocked on an account spending limit, this hook was the only
# gate left: a type error walked into tissue-core's main and failed the deploy
# pipeline on three consecutive commits. The command that finally caught it —
# `(cd api && npx tsc --noEmit)` — was sitting commented out four lines below
# here, differing only in a directory name.
#
# Hence: an unedited template is a repo that has not made a decision yet, and
# the safe reading of "no decision" is not "no typecheck needed".
#
# ADAPTING THIS BLOCK — set TYPECHECK to one of:
#
#   configured  ... and replace the placeholder in the block below with the
#                   commands that typecheck this repo's packages.
#   none        ... this repo genuinely has no typecheck (e.g. a pure-bash
#                   repo). Nothing runs, and the closing line will say so.
#
# Note the residual gap, which is deliberate rather than overlooked: setting
# `configured` and leaving the placeholder alone passes. Closing that would mean
# guessing whether an arbitrary command really typechecks anything. The failure
# this gate exists to stop is the UNMADE decision, not a badly made one.
#
# The whole block below — including the "unconfigured, refuse" branch and the
# `prisma generate`-style setup a filled-in TYPECHECK=configured block would
# run before its actual type-check commands — is skipped outright when
# DOCS_ONLY is true. None of it can have anything to say about a commit that
# touches no code, and running it anyway is exactly the friction this
# short-circuit exists to remove: it would force a fresh, dependency-less
# worktree to install a toolchain for the sole purpose of typechecking zero
# files. Skipping does not increment checks_run, and deliberately so — a
# skipped gate did not verify anything, and the closing summary below must
# stay truthful about that.
if [[ "$DOCS_ONLY" != true ]]; then

TYPECHECK=unconfigured

if [[ "$TYPECHECK" == "unconfigured" ]]; then
  cat >&2 <<EOF

  ✗ typecheck not configured for this repo

  \`.githooks/pre-commit\` ships with its typecheck block unconfigured, and this
  repo has not adapted it yet. The hook refuses rather than skipping, because a
  hook that silently checks nothing still prints "checks passed" — which is how
  a type error reached a protected branch and broke three deploys.

  Open .githooks/pre-commit, find the TYPECHECK line, and set it to either:

      TYPECHECK=configured   # then fill in the commands just below it, e.g.
                             #   (cd "\$ROOT/api" && npx --no-install tsc --noEmit)

      TYPECHECK=none         # this repo has no typecheck to run

  Commit that change with the repo — it belongs in version control, so every
  clone inherits the decision instead of re-making it.

  To get past this one commit without deciding:  git commit --no-verify

EOF
  exit 1
fi

if [[ "$TYPECHECK" != "none" ]]; then
  # Vue/TS gotcha from the pilot: a bare `vue-tsc --noEmit` against a
  # solution-style tsconfig.json (empty `files: []`, only `references`) checks
  # an EMPTY program — it always passes and catches nothing. Use build mode
  # (`-b`) so the real project references are checked.
  #
  # Examples, to delete once yours are in. Keep `require_installed_deps` first
  # and `--no-install` on every npx: without them a dependency-less worktree
  # silently downloads an unpinned tool from the registry and runs that, instead
  # of failing (see the helper above); with them a missing tool is an error.
  #   require_installed_deps backend frontend
  #   echo "==> Backend type-check..."
  #   (cd "$ROOT/backend" && npx --no-install tsc --noEmit)
  #   echo "==> Frontend type-check..."
  #   (cd "$ROOT/frontend" && npx --no-install vue-tsc -b)
  : # <-- replace with your stack's typecheck commands
  checks_run=$((checks_run + 1))
fi

fi # DOCS_ONLY

# Truthful by construction. Two distinct ways to verify nothing reach here, and
# they must not be reported as one: a repo that configured no gates at all, and
# a docs-only commit whose gates were skipped as inapplicable. Saying "no checks
# configured" for the second would misdescribe a working hook as an empty one —
# the same false-assurance failure this summary exists to prevent, inverted.
if [[ "$checks_run" -eq 0 ]]; then
  if [[ "$DOCS_ONLY" == true ]]; then
    echo "==> Pre-commit: docs-only commit — no gate here applies to it; nothing verified."
  else
    echo "==> Pre-commit: no checks configured for this repo — nothing verified."
  fi
elif [[ "$DOCS_ONLY" == true ]]; then
  # Something ran (formatting), so this is not an empty pass — but the code
  # gates did not, and an unqualified "checks passed" would imply they had.
  echo "==> Pre-commit checks passed (code gates skipped: docs-only commit)."
else
  echo "==> Pre-commit checks passed."
fi
